# ─── Required ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Groq ─────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_LARF_MODEL=llama-3.3-70b-versatile
# other options: llama-3.1-8b-instant | mixtral-8x7b-32768 | gemma2-9b-it

# ─── Mistral (OCR) ────────────────────────────────────────────────────────────
MISTRAL_API_KEY=your_mistral_api_key_here

# ─── Cache ────────────────────────────────────────────────────────────────────
# Master on/off toggle (default: true)
CACHE_ENABLED=true

# TTL for every cached entry in seconds (default: 86400 = 24 hours)
CACHE_TTL_SECONDS=86400

# Upstash Redis — required for Vercel production caching
# Get from: Vercel Dashboard → Storage → Browse Marketplace → Upstash Redis
# Leave blank to use in-memory fallback (good for local dev)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Protects /admin/cache/* endpoints. Leave blank for open access (local dev).
ADMIN_API_KEY=your_secret_admin_key

# ─── Optional ─────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
LOG_LEVEL=INFO
